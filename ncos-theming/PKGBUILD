# Maintainer: exothermic88
# No source=() — package() copies the scripts straight from the theming
# repo checkout via $startdir, so makepkg must run inside this directory.
pkgname=ncos-theming
pkgver=1.0
pkgrel=1
pkgdesc="NCOS theme and wallpaper switching scripts (awww-based, COSMIC)"
arch=('any')
license=('GPL')
depends=('bash' 'rofi' 'awww')

package() {
    local scripts=(
        theme-lib.sh
        theme-select.sh
        theme-select-previous.sh
        wallselect.sh
        wallcycle.sh
    )
    for s in "${scripts[@]}"; do
        install -Dm755 "$startdir/../usr/bin/$s" "$pkgdir/usr/bin/$s"
    done
}
