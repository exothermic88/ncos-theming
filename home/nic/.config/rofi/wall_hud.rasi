configuration {
    show-icons: false;
}

* {
    background-color: transparent;
    text-color: #ffffff;
    font: "Sans 11";
}

window {
    width: 850px;
    height: 250px;
    anchor: center;
    location: center;
    border-radius: 16px;
    border: 2px;
    border-color: #ffffff33;
    background-color: transparent;
    children: [ mainbox ];
}

mainbox {
    orientation: vertical;
    padding: 20px;
    children: [ textbox-title, dummy, box-images ];
}

textbox-title {
    str: "CHANGING WALLPAPER...";
    horizontal-align: 0.5;
    font: "Sans Bold 14";
    text-color: #a970ff;
}

dummy {
    expand: true;
}

box-images {
    orientation: horizontal;
    spacing: 20px;
    children: [ textbox-prev, textbox-curr, textbox-next ];
}

textbox-prev, textbox-curr, textbox-next {
    width: 250px;
    height: 140px;
    border-radius: 10px;
    border: 1px;
    border-color: #ffffff1a;
    str: " ";
}

/* Highlight the center box */
textbox-curr {
    border: 2px;
    border-color: #a970ff;
}

/* Dynamically load the actual wallpaper paths generated by our bash script */
@import "/tmp/wallcycle/images.rasi"